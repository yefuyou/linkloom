{
  "tool_id": "emit_semantic_candidates",
  "version": "semantic-candidate/v2",
  "description": "Return structured source-grounded claim proposals; never write memory.",
  "input_schema": {
    "type": "object",
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "claim_type": {
              "type": "string",
              "enum": [
                "DECISION",
                "FACT",
                "PROPOSAL",
                "QUESTION",
                "REJECTED_OPTION",
                "PLAN",
                "ACTION",
                "OPINION",
                "SPECULATION"
              ]
            },
            "subject": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "relation": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "temporal_status": {
              "type": "string",
              "enum": [
                "SOURCE_EVENT_TIME",
                "EXPLICIT",
                "UNRESOLVED",
                "NOT_STATED"
              ]
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "confidence": {
              "type": "object",
              "properties": {
                "claim_type": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "entity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "relation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "temporal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "overall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "claim_type",
                "entity",
                "relation",
                "temporal",
                "overall"
              ],
              "additionalProperties": false
            },
            "task": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "description_parts": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "deadline_text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "project": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                },
                "vendor": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 512
                }
              },
              "required": [
                "text",
                "description_parts",
                "owner",
                "deadline_text",
                "project",
                "vendor"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "claim_type",
            "subject",
            "relation",
            "value",
            "temporal_status",
            "valid_from",
            "valid_to",
            "confidence",
            "task"
          ],
          "additionalProperties": false
        },
        "maxItems": 20
      }
    },
    "required": [
      "claims"
    ],
    "additionalProperties": false
