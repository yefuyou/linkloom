# ------------------------------------------------------------------
# Linkloom environment variables — copy to .env and fill in values.
# .env is in .gitignore and will NOT be committed.
# ------------------------------------------------------------------

# Required for real-provider evaluation runs (WP-7+).
# Obtain from your OpenAI-compatible gateway console.
OPENAI_API_KEY=your-api-key-here

# Optional: override the default OpenAI base URL.
# Leave blank to use the standard https://api.openai.com endpoint.
OPENAI_BASE_URL=
