# 必填（启用产品 AI 提取/调查时；离线启动无需密钥）
# 用途：Gemini 提取与调查；仅显式启用外部服务时必填；示例：<your-gemini-api-key>（到 Google AI Studio 获取）。
GEMINI_API_KEY=
# 复制本文件为项目根目录的 .env 后填写；只有 python -m linkloom.ui 启动器会自动加载。
# 已存在的进程环境变量优先（包括空值）；修改配置后重启。网页不接收或保存密钥。
# 无 key 可创建工作区、保存来源、审核已有候选、查询已审核决定及历史；离线演示使用 --offline-task-demo。

# 常用可选
# 用途：本地 SQLite 数据库；选填，默认 ~/.linkloom/product.sqlite；示例：work/product.sqlite。
# LINKLOOM_DATABASE_PATH=work/product.sqlite
# 用途：本地检索模式；选填，默认 hybrid 需 retrieval 扩展和嵌入模型；示例：bm25（无需嵌入模型）。
# LINKLOOM_RETRIEVAL_MODE=bm25
# 用途：HTTP 代理与诊断；选填，clean eval 要求指定端点；示例：http://127.0.0.1:7897。
# HTTP_PROXY=http://127.0.0.1:7897
# 用途：HTTPS 代理与诊断；选填，clean eval 要求指定端点；示例：http://127.0.0.1:7897。
# HTTPS_PROXY=http://127.0.0.1:7897
# 用途：通用代理与诊断；选填，clean eval 要求指定端点；示例：http://127.0.0.1:7897。
# ALL_PROXY=http://127.0.0.1:7897
# 用途：代理例外；选填，clean eval 要求为空；示例：localhost,127.0.0.1（仅普通本地运行）。
# NO_PROXY=localhost,127.0.0.1

# 高级/开发用
# 高级产品配置与代理兼容名称；普通产品体验无需设置。
# 用途：产品 Gemini 模型；选填，当前仅支持固定型号；示例：gemini-3.8-flash。
# LINKLOOM_SEMANTIC_MODEL=gemini-3.8-flash
# 用途：HTTP 代理的小写兼容名称；选填，与大写值一致；示例：http://127.0.0.1:7897。
# http_proxy=http://127.0.0.1:7897
# 用途：HTTPS 代理的小写兼容名称；选填，与大写值一致；示例：http://127.0.0.1:7897。
# https_proxy=http://127.0.0.1:7897
# 用途：通用代理的小写兼容名称；选填，与大写值一致；示例：http://127.0.0.1:7897。
# all_proxy=http://127.0.0.1:7897
# 用途：代理例外的小写兼容名称；选填，clean eval 要求为空；示例：localhost,127.0.0.1。
# no_proxy=localhost,127.0.0.1

# 开发用：评测、任务验收、独立 live 与测试工具。配置这些变量不代表取得运行授权。
# 用途：旧版 OpenAI 兼容评测；仅选用该服务时必填；示例：<your-openai-api-key>；对应脚本：relation_eval/runner/run_evaluation.py。
OPENAI_API_KEY=
# 用途：OpenAI 兼容服务地址；选填，默认官方地址；示例：https://api.openai.com/v1；对应脚本：relation_eval/runner/run_evaluation.py。
# OPENAI_BASE_URL=https://api.openai.com/v1
# 用途：DeepSeek 实际调用；仅选用 DeepSeek 时必填；示例：<your-deepseek-api-key>；对应脚本：scripts/eval_routing.py、scripts/eval_tasks.py、tests/smoke/test_deepseek_real_provider_smoke.py。
DEEPSEEK_API_KEY=
# 用途：reliability_probe/reliability_rag_baseline 的 Gemini 备用凭证及 SDK 环境；选填，不能代替网页的 GEMINI_API_KEY；示例：<your-google-api-key>；对应脚本：scripts/reliability_probe.py、scripts/reliability_rag_baseline.py（备用凭证）。
GOOGLE_API_KEY=
# 用途：Gemini SDK 的 Vertex AI 模式；选填，产品显式使用 Developer API，live 脚本禁止启用 Vertex；示例：false；对应脚本：scripts/run_m3d_live.py（安全断言）；产品固定使用 Developer API。
# GOOGLE_GENAI_USE_VERTEXAI=false
# 用途：真实 Gemini smoke 的 opt-in；选填，默认关闭，开启仍需独立授权；示例：0（关闭）；对应脚本：tests/smoke/test_m04_real_provider_smoke.py、tests/smoke/test_m12_real_provider_team_decision_smoke.py。
# LINKLOOM_RUN_REAL_PROVIDER_SMOKE=0
# 用途：真实 DeepSeek smoke 的 opt-in；选填，默认关闭；示例：0（关闭）；对应脚本：tests/smoke/test_deepseek_real_provider_smoke.py、tests/smoke/test_deepseek_business_evaluation.py。
# LINKLOOM_RUN_DEEPSEEK_REAL_SMOKE=0
# 用途：真实 smoke 的独立授权；仅相应 live 流程必填；示例：<经审核协议指定的授权短语>，不要预填；对应脚本：tests/smoke/test_m12_real_provider_team_decision_smoke.py。
# LINKLOOM_REAL_PROVIDER_SMOKE_AUTHORIZATION=
# 用途：Gate A / M1.2 的固定模型；选填，默认 gemini-3.8-flash；示例：gemini-3.8-flash；对应脚本：tests/smoke/test_m04_real_provider_smoke.py、tests/smoke/test_m12_real_provider_team_decision_smoke.py。
# LINKLOOM_GATE_A_MODEL=gemini-3.8-flash
# 用途：MPS-001 独立重跑 opt-in；选填，默认关闭；示例：0（关闭）；对应脚本：tests/smoke/test_m12_real_provider_team_decision_smoke.py。
# LINKLOOM_M12_MPS_001_RERUN=0
# 用途：统一传输实验的独立授权；仅相应 live 流程必填；示例：<经审核协议指定且绑定实验身份的授权短语>；对应脚本：scripts/gemini_transport/unified.py。
# LINKLOOM_UNIFIED_TRANSPORT_AUTHORIZATION=
# 用途：temporal release gate 的独立授权；仅相应 live 流程必填；示例：<经审核协议指定的授权短语>；对应脚本：tests/smoke/run_temporal_product_http.py（release gate）。
# LINKLOOM_TEMPORAL_RELEASE_GATE_AUTHORIZATION=
# 用途：temporal next stage 的独立授权；仅相应 live 流程必填；示例：<经审核协议指定的授权短语>；对应脚本：tests/smoke/run_temporal_product_http.py（next stage）。
# LINKLOOM_TEMPORAL_NEXT_STAGE_AUTHORIZATION=
# 用途：Windows pytest 临时目录兼容插件的根目录；选填，无默认覆盖；示例：work/pytest-temp-unique（每次新建）；对应脚本：scripts/pytest_windows_tempdir.py、scripts/run_validation_regression.py。
# LINKLOOM_PYTEST_BASETEMP=work/pytest-temp-unique
# 用途：回归测试 XML 输出位置；选填，默认 docs/evaluation/validation_regression.xml；示例：work/validation-regression.xml；对应脚本：scripts/run_validation_regression.py。
# LINKLOOM_VALIDATION_REGRESSION_REPORT=work/validation-regression.xml
# 用途：P2B 证据核验阶段；选填，默认不执行 after 阶段回执检查；示例：after；对应脚本：tests/integration/test_inspect_ledger_dependency.py、tests/integration/test_inspect_ledger_cold_process.py。
# LINKLOOM_P2B_EVIDENCE_PHASE=after
# 用途：P2 联合产品测试回执输出；选填，未设置不输出；示例：work/p2-joint-receipt.json；对应脚本：tests/integration/test_p2_joint_product.py。
# LINKLOOM_P2_JOINT_RECEIPT=work/p2-joint-receipt.json
# 用途：P2 身份 HTTP 测试回执输出；选填，未设置不输出；示例：work/p2-receipt.json；对应脚本：tests/integration/test_p2_work_identity_http.py。
# LINKLOOM_P2_RECEIPT=work/p2-receipt.json
# 用途：浏览器验收的 Python 可执行文件；选填，默认 python；示例：python；对应脚本：tests/ui/product_copy_browser.cjs、tests/ui/stale_revalidation_browser.cjs。
# LINKLOOM_TEST_PYTHON=python
# 用途：浏览器验收的 Chromium 可执行文件；选填，默认 Playwright 提供；示例：/path/to/chromium；对应脚本：tests/ui/product_copy_browser.cjs。
# LINKLOOM_CHROMIUM_EXECUTABLE=/path/to/chromium
# 用途：本地源码与测试模块搜索路径；选填，安装包后无需设置；示例：src（多路径按操作系统分隔）；对应脚本：tests/cli_support.py、scripts/run_validation_regression.py 等本地源码/测试入口。
# PYTHONPATH=src
# 用途：Python UTF-8 模式；选填；示例：1；对应脚本：tests/cli_support.py、scripts/reconcile_m3d_tests.py 等测试入口。
# PYTHONUTF8=1
# 用途：子进程标准输入输出编码；选填；示例：utf-8；对应脚本：tests/cli_support.py、scripts/run_m3d_offline.py 等子进程入口。
# PYTHONIOENCODING=utf-8
# 用途：禁止写入 Python 字节码；选填；示例：1；对应脚本：scripts/bench_scale.py、tests/smoke/run_temporal_product_http_with_tree_timeout.ps1。
# PYTHONDONTWRITEBYTECODE=1
# 用途：浏览器验收服务日志即时输出；选填；示例：1；对应脚本：tests/ui/product_copy_browser.cjs。
# PYTHONUNBUFFERED=1
# 用途：禁用外部 pytest 插件自动加载；选填；示例：1；对应脚本：scripts/reconcile_m3d_tests.py、scripts/run_m3d_offline.py 等测试入口。
# PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
# 用途：Hugging Face Hub 离线；选填，bench_scale 会设为 1；示例：1（需已缓存模型）；对应脚本：scripts/bench_scale.py。
# HF_HUB_OFFLINE=1
# 用途：Transformers 离线；选填，bench_scale 会设为 1；示例：1（需已缓存模型）；对应脚本：scripts/bench_scale.py。
# TRANSFORMERS_OFFLINE=1
# 用途：关闭 Hugging Face 遥测；选填，bench_scale 会设为 1；示例：1；对应脚本：scripts/bench_scale.py。
# HF_HUB_DISABLE_TELEMETRY=1
# 用途：关闭 W&B 日志集成；选填，bench_scale 会设置；示例：true；对应脚本：scripts/bench_scale.py。
# WANDB_DISABLED=true
# 用途：限制本地嵌入可见的 GPU；选填，bench_scale 会置空以使用 CPU；示例：空值（CPU）；对应脚本：scripts/bench_scale.py。
# CUDA_VISIBLE_DEVICES=
# 用途：Windows 超时包装脚本定位 taskkill.exe；由系统提供，无需手填；示例：C:/Windows；对应脚本：tests/smoke/run_temporal_product_http_with_tree_timeout.ps1（由 Windows 提供）。
# SystemRoot=
